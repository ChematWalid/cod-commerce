# {{ ansible_managed }}
# Data services only. The compose file also describes the app roles; Kamal runs those with their own environment.
COMPOSE_PROJECT_NAME={{ data_tier_compose_project }}
# Required by the compose file's shared app block, even though no app service starts from this file.
APP_ENV=staging
TZ=UTC
DATA_BIND_ADDR={{ data_tier_bind_addr }}
POSTGRES_USER={{ data_tier_postgres_user }}
POSTGRES_PASSWORD={{ data_tier_postgres_password }}
POSTGRES_DB={{ data_tier_postgres_db }}
PGBOUNCER_DEFAULT_POOL_SIZE={{ data_tier_pgbouncer_pool_size }}
VALKEY_MAXMEMORY={{ data_tier_valkey_maxmemory }}
GARAGE_RPC_SECRET={{ data_tier_garage_rpc_secret }}
GARAGE_ADMIN_TOKEN={{ data_tier_garage_admin_token }}
S3_ACCESS_KEY={{ data_tier_s3_access_key }}
S3_SECRET_KEY={{ data_tier_s3_secret_key }}
S3_BUCKET_PRIVATE={{ data_tier_s3_bucket_private }}
