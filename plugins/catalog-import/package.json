{
  "name": "@cod/plugin-catalog-import",
  "version": "0.0.0",
  "private": true,
  "description": "Bulk edit, export and import of a store's products, link import and the imports-exports queue (P2.S2).",
  "exports": {
    ".": {
      "@cod/source": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --configLoader runner",
    "test:integration": "vitest run --configLoader runner -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@cod/plugin-catalog": "workspace:*",
    "@cod/plugin-platform-flags": "workspace:*",
    "@cod/plugin-platform-jobs": "workspace:*",
    "@cod/plugin-tenancy": "workspace:*",
    "@cod/shared": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@vendure/core": "3.8.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@cod/config": "workspace:*",
    "@cod/plugin-platform-outbox": "workspace:*",
    "@cod/plugin-platform-partitions": "workspace:*",
    "@cod/plugin-rate-limit": "workspace:*",
    "@cod/plugin-rbac": "workspace:*",
    "@cod/testing": "workspace:*",
    "@types/node": "24.19.2",
    "@vendure/testing": "3.8.1",
    "graphql-tag": "2.12.7",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
