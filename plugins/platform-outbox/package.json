{
  "name": "@cod/plugin-platform-outbox",
  "version": "0.0.0",
  "private": true,
  "description": "Transactional outbox: events written in the caller's transaction, relayed after commit and delivered to registered consumers, database effects exactly once (ADR 0016, D104-D107).",
  "exports": {
    ".": {
      "@cod/source": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --configLoader runner",
    "test:integration": "vitest run --configLoader runner -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@cod/plugin-platform-jobs": "workspace:*",
    "@cod/plugin-platform-partitions": "workspace:*",
    "@cod/plugin-tenancy": "workspace:*",
    "@cod/shared": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/graphql": "14.0.3",
    "@vendure/core": "3.8.1",
    "graphql-tag": "2.12.7",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@cod/config": "workspace:*",
    "@cod/plugin-rate-limit": "workspace:*",
    "@cod/testing": "workspace:*",
    "@nestjs/core": "12.4.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
