// The scaffold's aliases (as in plugins/merchant-shell). `@/gql` is only mirrored: nothing may import it in P0
// (ruling P4-1), because `src/gql` is generated by build:dashboard and git-ignored.
{
  "extends": "@cod/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "customConditions": ["@cod/source"],
    "paths": {
      "@/vdb/*": ["../node_modules/@vendure/dashboard/src/lib/*"],
      "@/gql": ["../../../apps/server/src/gql/graphql.ts"]
    }
  },
  "include": ["**/*"]
}
