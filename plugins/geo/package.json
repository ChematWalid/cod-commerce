{
  "name": "@cod/plugin-geo",
  "version": "0.0.0",
  "private": true,
  "description": "Algeria's geo reference data: the wilayas and communes (law 26-06, D3123), global tables read by a public endpoint.",
  "exports": {
    ".": {
      "@cod/source": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@cod/shared": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@vendure/core": "3.8.1"
  },
  "devDependencies": {
    "@cod/config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
