{
  "name": "@cod/plugin-platform-flags",
  "version": "0.0.0",
  "private": true,
  "description": "Operational feature flags and kill switches: staff-managed defaults, rollout percent and plan, business and store overrides, cached in the process and Valkey (D116).",
  "exports": {
    ".": {
      "@cod/source": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && cod-typecheck-own dashboard/tsconfig.json",
    "test": "vitest run --configLoader runner",
    "test:integration": "vitest run --configLoader runner -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@cod/plugin-merchant-shell": "workspace:*",
    "@cod/plugin-platform-jobs": "workspace:*",
    "@cod/plugin-tenancy": "workspace:*",
    "@cod/shared": "workspace:*",
    "@lingui/react": "5.9.5",
    "@nestjs/common": "12.4.0",
    "@nestjs/graphql": "14.0.3",
    "@tanstack/react-query": "5.107.1",
    "@vendure/core": "3.8.1",
    "@vendure/dashboard": "3.8.1",
    "graphql-tag": "2.12.7",
    "ioredis": "5.11.1",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@cod/config": "workspace:*",
    "@cod/plugin-rate-limit": "workspace:*",
    "@cod/testing": "workspace:*",
    "@nestjs/core": "12.4.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
