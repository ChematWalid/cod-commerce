{
  "name": "@cod/plugin-tenancy",
  "version": "0.0.0",
  "private": true,
  "description": "Businesses and stores mapped onto Vendure sellers and channels (ADR 0002), and snowflake worker leases (ADR 0003).",
  "exports": {
    ".": {
      "@cod/source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./provisioning": {
      "@cod/source": "./provisioning.ts",
      "default": "./dist/provisioning.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --configLoader runner",
    "test:integration": "vitest run --configLoader runner -c vitest.integration.config.ts",
    "test:pgbouncer": "vitest run --configLoader runner -c vitest.pgbouncer.config.ts"
  },
  "dependencies": {
    "@cod/plugin-rate-limit": "workspace:*",
    "@cod/shared": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/graphql": "14.0.3",
    "@vendure/core": "3.8.1",
    "graphql-tag": "2.12.7",
    "ioredis": "5.11.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@cod/config": "workspace:*",
    "@cod/testing": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
