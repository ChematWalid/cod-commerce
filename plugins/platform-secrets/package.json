{
  "name": "@cod/plugin-platform-secrets",
  "version": "0.0.0",
  "private": true,
  "description": "Envelope-encrypted tenant secrets: one data key per business wrapped by a key-encryption key, AES-256-GCM values bound to their owner by AAD (ADR 0002, D114).",
  "exports": {
    ".": {
      "@cod/source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./kek-ring": {
      "@cod/source": "./kek-ring.ts",
      "default": "./dist/kek-ring.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --configLoader runner",
    "test:integration": "vitest run --configLoader runner -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@cod/plugin-platform-jobs": "workspace:*",
    "@cod/plugin-rbac": "workspace:*",
    "@cod/plugin-tenancy": "workspace:*",
    "@cod/shared": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/graphql": "14.0.3",
    "@vendure/core": "3.8.1",
    "graphql-tag": "2.12.7",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@cod/config": "workspace:*",
    "@cod/plugin-platform-partitions": "workspace:*",
    "@cod/plugin-rate-limit": "workspace:*",
    "@cod/testing": "workspace:*",
    "@nestjs/core": "12.4.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
