{
  "name": "@cod/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint, Vitest and architecture configuration. Never built: consumers read the source.",
  "bin": {
    "cod-typecheck-own": "./typecheck/own-sources.mts"
  },
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.vendure.json": "./tsconfig.vendure.json",
    "./eslint": "./eslint/index.mjs",
    "./lint-limits": "./eslint/lint-limits.mjs",
    "./architecture": "./architecture/check.ts",
    "./gates": "./gates/vendure-pins.ts",
    "./vitest/unit": "./vitest/unit.ts",
    "./vitest/vendure": "./vitest/vendure.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:arch": "vitest run tests/architecture.test.ts tests/vendure-pins.test.ts tests/ci-workflow.test.ts tests/branding.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vite": "7.3.7",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
