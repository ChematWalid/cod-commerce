{
  "name": "@cod/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Test helpers for plugin integration tests: the test database config, a Vendure test environment and the two-business fixtures.",
  "exports": {
    ".": {
      "@cod/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@cod/shared": "workspace:*",
    "@vendure/core": "3.8.1",
    "@vendure/testing": "3.8.1",
    "graphql-tag": "2.12.7"
  },
  "devDependencies": {
    "@cod/config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
