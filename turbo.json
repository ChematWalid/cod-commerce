{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": [
        "APP_ENV",
        "ROLE",
        "TZ",
        "DATABASE_URL",
        "DATABASE_URL_DIRECT",
        "DB_POOL_MAX",
        "REDIS_URL",
        "PLATFORM_DOMAIN",
        "INTERNAL_API_URL",
        "DEMO_OWNER_PASSWORD",
        "SNOWFLAKE_WORKER_ID",
        "WORKER_POOL",
        "API_PORT",
        "WORKER_HEALTH_PORT",
        "COOKIE_SECRET",
        "AUTH_*",
        "SMTP_*",
        "MAILPIT_*",
        "GOOGLE_OAUTH_*",
        "FACEBOOK_OAUTH_*",
        "TURNSTILE_*",
        "SUPERADMIN_USERNAME",
        "SUPERADMIN_PASSWORD",
        "S3_*",
        "CORS_ORIGINS",
        "TRUSTED_PROXY_HOPS",
        "LOG_LEVEL"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
