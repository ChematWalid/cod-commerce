#!/usr/bin/env bash
# Refuse pushes to main: every change goes through a PR (see docs/roadmap/CONTRIBUTING.md).
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push to main rejected: open a PR instead (docs/roadmap/CONTRIBUTING.md)." >&2
    exit 1
  fi
done
exit 0
