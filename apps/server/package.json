{
  "name": "@cod/server",
  "version": "0.0.0",
  "private": true,
  "description": "The Vendure server: api, worker and migrate roles.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/browser/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "build:dashboard": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js build",
    "dev": "pnpm run migrate && pnpm run --parallel \"/^dev:(api|worker)$/\"",
    "dev:api": "ROLE=api node --env-file-if-exists=.env --conditions=@cod/source -r ts-node/register/transpile-only src/main-api.ts",
    "dev:worker": "ROLE=worker node --env-file-if-exists=.env --conditions=@cod/source -r ts-node/register/transpile-only src/main-worker.ts",
    "dev:dashboard": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js dev",
    "test": "vitest run --configLoader runner --project unit",
    "test:integration": "vitest run --configLoader runner --project e2e",
    "test:browser": "vitest run --configLoader runner -c vitest.browser.config.ts",
    "migrate": "ROLE=migrate node --env-file-if-exists=.env --conditions=@cod/source -r ts-node/register/transpile-only src/main-migrate.ts",
    "seed:demo": "ROLE=migrate node --env-file-if-exists=.env --conditions=@cod/source -r ts-node/register/transpile-only src/main-seed-demo.ts",
    "migration:generate": "ROLE=migrate node --env-file-if-exists=.env --conditions=@cod/source -r ts-node/register/transpile-only src/scripts/generate-migration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/lib-storage": "3.1164.0",
    "@cod/plugin-auth": "workspace:*",
    "@cod/plugin-catalog": "workspace:*",
    "@cod/plugin-merchant-shell": "workspace:*",
    "@cod/plugin-platform-flags": "workspace:*",
    "@cod/plugin-platform-health": "workspace:*",
    "@cod/plugin-platform-jobs": "workspace:*",
    "@cod/plugin-platform-outbox": "workspace:*",
    "@cod/plugin-platform-partitions": "workspace:*",
    "@cod/plugin-platform-secrets": "workspace:*",
    "@cod/plugin-platform-webhooks": "workspace:*",
    "@cod/plugin-rate-limit": "workspace:*",
    "@cod/plugin-rbac": "workspace:*",
    "@cod/plugin-team": "workspace:*",
    "@cod/plugin-template": "workspace:*",
    "@cod/plugin-tenancy": "workspace:*",
    "@cod/shared": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@vendure/asset-server-plugin": "3.8.1",
    "@vendure/core": "3.8.1",
    "@vendure/dashboard": "3.8.1",
    "@vendure/harden-plugin": "3.8.1",
    "@vendure/job-queue-plugin": "3.8.1",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "typeorm": "0.3.31",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cod/config": "workspace:*",
    "@swc/core": "1.16.22",
    "@types/pg": "8.23.1",
    "@vendure/testing": "3.8.1",
    "graphql-tag": "2.12.7",
    "playwright-core": "1.65.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
