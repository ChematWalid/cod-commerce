# Host-run storefront (the data services come from the root docker-compose.yml).
# Copy to .env (next dev, next build and next start load it). Never commit real values.
# The storefront validates APP_ENV, REDIS_URL, NEXT_DEPLOYMENT_ID and INTERNAL_API_URL when it starts and exits
# on an invalid one (src/config/storefront-env.ts). next build needs NEXT_DEPLOYMENT_ID only.
# The port next dev and next start listen on.
STOREFRONT_PORT=3001
# development, test, staging or production. Only development has fallbacks for REDIS_URL and NEXT_DEPLOYMENT_ID.
APP_ENV=development
# The Valkey that holds the shared cache (the port compose publishes on the host).
REDIS_URL=redis://localhost:6380
# The API the storefront asks which store a host belongs to. Required in every environment.
INTERNAL_API_URL=http://localhost:3100
# For host next dev only; host builds export a commit id (NEXT_DEPLOYMENT_ID=$(git rev-parse --short HEAD)).
NEXT_DEPLOYMENT_ID=dev
# The keys the storefront signs its api calls with (ADR 0008); the same list the api verifies against.
INTERNAL_HMAC_KEYS=k1:change-me-internal-hmac-000000000000000000000
# The kid the signers use (the storefront); it must be one of the kids above.
INTERNAL_HMAC_ACTIVE_KID=k1
