# Host-run storefront (the data services come from the root docker-compose.yml).
# Copy to .env (next dev, next build and next start load it). Never commit real values.
# The storefront validates APP_ENV, REDIS_URL, NEXT_DEPLOYMENT_ID, INTERNAL_API_URL, the two HMAC keys and PLATFORM_DOMAIN when it starts and exits
# on an invalid one (src/config/storefront-env.ts). next build needs NEXT_DEPLOYMENT_ID only.
# The port next dev and next start listen on.
STOREFRONT_PORT=3001
# development, test, staging or production. Only development has fallbacks for REDIS_URL and NEXT_DEPLOYMENT_ID.
APP_ENV=development
# The Valkey that holds the shared cache (the port compose publishes on the host).
REDIS_URL=redis://localhost:6380
# The API the storefront asks which store a host belongs to. Required in every environment.
INTERNAL_API_URL=http://localhost:3100
# For host next dev only; host builds export a commit id (NEXT_DEPLOYMENT_ID=$(git rev-parse --short HEAD)).
NEXT_DEPLOYMENT_ID=dev
# The keys the storefront signs its api calls with (ADR 0008); the same list the api verifies against.
INTERNAL_HMAC_KEYS=k1:change-me-internal-hmac-000000000000000000000
# The kid the signers use (the storefront); it must be one of the kids above.
INTERNAL_HMAC_ACTIVE_KID=k1
# Stores live on <label>.PLATFORM_DOMAIN; any other host is answered 404 without asking the api (custom domains come in
# P8.S9). Defaults to localhost outside staging and production, which must set it.
PLATFORM_DOMAIN=localhost
# The theme every store renders with: default or compact (D3207; per-store themes come with the builder, P8). Optional,
# default when unset.
STOREFRONT_THEME=default
# Where buyers load product images: the api's public asset route (D3209). Optional; unset means /assets on the store's
# own host.
STOREFRONT_ASSET_BASE=http://localhost:3100/assets
# Optional CDN prefix of the static files (next.config assetPrefix, read at build and start).
STOREFRONT_ASSET_PREFIX=
# true only behind Cloudflare: CF-Connecting-IP is then sent to the api as the buyer address (D3213). Default false;
# required true when APP_ENV is staging or production. Enable it only once this origin is reachable through Cloudflare
# alone (Tunnel, authenticated origin pulls, or a firewall allow-list of Cloudflare's IP ranges): the header is believed
# from any caller, so a direct origin hit could forge a fresh per-buyer rate-limit bucket on every request.
STOREFRONT_TRUST_EDGE_IP=false
# 32 random bytes in base64 (openssl rand -base64 32), the same for every instance and build. Required unless APP_ENV
# is development or test; never commit a real value.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# OpenTelemetry (an OTLP/HTTP collector endpoint, e.g. http://localhost:4318) and Sentry (the storefront project's DSN,
# EU region), each off while blank (ADR 0015). Never commit a real DSN.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
