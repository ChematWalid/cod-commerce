# Copy to .kamal/secrets.staging (git-ignored); keep it as references only. Kamal reads this dotenv file at deploy
# time and expands each $NAME from the environment, which the deploy job fills from the `staging` GitHub
# Environment's secrets (deploy/README.md). Never write a value here.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
ORIGIN_CA_CERTIFICATE_PEM=$ORIGIN_CA_CERTIFICATE_PEM
ORIGIN_CA_PRIVATE_KEY_PEM=$ORIGIN_CA_PRIVATE_KEY_PEM
DATABASE_URL=$DATABASE_URL
DATABASE_URL_DIRECT=$DATABASE_URL_DIRECT
S3_ACCESS_KEY=$S3_ACCESS_KEY
S3_SECRET_KEY=$S3_SECRET_KEY
COOKIE_SECRET=$COOKIE_SECRET
AUTH_TOKEN_SECRET=$AUTH_TOKEN_SECRET
SUPERADMIN_PASSWORD=$SUPERADMIN_PASSWORD
INTERNAL_HMAC_KEYS=$INTERNAL_HMAC_KEYS
INTERNAL_HMAC_ACTIVE_KID=$INTERNAL_HMAC_ACTIVE_KID
TENANT_SECRET_KEKS=$TENANT_SECRET_KEKS
TENANT_SECRET_ACTIVE_KID=$TENANT_SECRET_ACTIVE_KID
QUOTE_HMAC_KEYS=$QUOTE_HMAC_KEYS
QUOTE_HMAC_ACTIVE_KID=$QUOTE_HMAC_ACTIVE_KID
SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD
CLOUDFLARE_API_TOKEN=$CLOUDFLARE_API_TOKEN
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=$NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
